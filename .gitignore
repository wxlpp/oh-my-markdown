# macOS
.DS_Store
.AppleDouble
.LSOverride

# Icon must end with two \\r
Icon\\r
._*

# Thumbnails and Spotlight
.Spotlight-V100
.Trashes
.fseventsd
.DocumentRevisions-V100
.VolumeIcon.icns

# Xcode
# See: https://github.com/github/gitignore/blob/main/Swift.gitignore
DerivedData/
build/
*.pbxuser
!default
*.mode1v3
*.mode2v3
*.perspectivev3
xcuserdata/
*.xcuserstate
*.xcuserdatad
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
*.xccheckout
*.xcscmblueprint
*.xcdebugger

# Workspaces and shared settings
*.xcworkspace
xcshareddata/WorkspaceSettings.xcsettings

# Swift Package Manager
.build/
Packages/
Package.resolved
.swiftpm
.worktrees/
.artifacts/

# CocoaPods
Pods/
Podfile.lock

# Carthage
Carthage/Build/
Carthage/Checkouts/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output/

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# Xcode Server
integration/

# IDEs
.idea/
.vscode/

# Misc
*.orig
*.swp
*~
.DS_Store?

# Ignore user-specific files
*.log
*.tmp

# Archive files
*.zip
*.tar.gz
*.tgz

# Generated by SwiftPM
/.build

# Ignore environment files
.env
.env.*
